# Windows PowerShell 5.1 scripts: keep CRLF (and the UTF-8 BOM the script is saved with)
*.ps1 text eol=crlf
*.md  text eol=crlf
*.cpp text eol=crlf
*.h   text eol=crlf
*.cs  text eol=crlf
*.dll binary
*.propdesc text eol=crlf
*.cmd text eol=crlf
*.png binary
# Code of others, kept byte for byte as it came (no end-of-line conversion)
third_party/** -text
